---
import "../styles/global.css";

// Self-hosted fonts via Fontsource (no third-party requests at runtime):
// Fraunces (display, all axes incl. SOFT/WONK), Newsreader (text, optical sizing),
// Spline Sans Mono (labels, counters), Amiri (Arabic display type).
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/spline-sans-mono";
import "@fontsource/amiri/arabic.css";
import "@fontsource/amiri/arabic-700.css";

import release from "../data/release.json";

// Google Search Console verification token.
// Paste the token from search.google.com/search-console (the "HTML tag"
// method) between the quotes, then deploy — Google verifies it on the next
// request. Empty until then, in which case no tag is rendered.
const GOOGLE_VERIFICATION = "";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e7" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    {
      GOOGLE_VERIFICATION && (
        <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BreakFree / تعافي" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta
      property="og:image"
      content={new URL("/og.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="BreakFree / تعافي — The fight is private. So is the help."
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ar_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: "BreakFree / تعافي",
            alternateName: "تعافي",
            url: Astro.site?.href,
            inLanguage: ["en", "ar"],
          },
          {
            "@type": "SoftwareApplication",
            name: "BreakFree — تعافي",
            alternateName: "تعافي",
            operatingSystem: "Android",
            applicationCategory: "HealthApplication",
            description:
              "An open-source Android recovery companion for quitting compulsive pornography use: a live clean-streak tracker, CBT-based SOS exercises, an AI counselor, and an anonymous community. Private by design.",
            inLanguage: ["en", "ar"],
            isAccessibleForFree: true,
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
            softwareVersion: release.tag.replace(/^v/, ""),
            author: {
              "@type": "Organization",
              name: "YUouriii",
              url: "https://github.com/YUouriii",
            },
            downloadUrl:
              "https://github.com/YUouriii/taafi-app/releases/latest/download/BreakFree.apk",
            installUrl:
              "https://github.com/YUouriii/taafi-app/releases/latest/download/BreakFree.apk",
            sameAs: ["https://github.com/YUouriii/taafi-app"],
          },
          {
            "@type": "HowTo",
            name: "How to install BreakFree on Android",
            inLanguage: ["en", "ar"],
            description:
              "Install the BreakFree (تعافي) APK on an Android phone: allow the unknown source, answer the Play Protect prompt, and verify the signature fingerprint.",
            totalTime: "PT3M",
            supply: [
              {
                "@type": "HowToSupply",
                name: "BreakFree APK",
                url: new URL("/BreakFree.apk", Astro.site).href,
              },
            ],
            tool: [
              {
                "@type": "HowToTool",
                name: "Android Files app / Settings",
              },
            ],
            step: [
              {
                "@type": "HowToStep",
                name: "Download the APK",
                text: "Tap the download button; the file lands in your Downloads folder.",
                url: new URL("/#install", Astro.site).href,
              },
              {
                "@type": "HowToStep",
                name: "Open it from Files",
                text: "Open Files → Downloads → BreakFree.apk, then tap Install.",
                url: new URL("/#install", Astro.site).href,
              },
              {
                "@type": "HowToStep",
                name: "Allow this source, once",
                text: "In Settings → Install unknown apps, allow the app you are opening the file with (Files or Chrome), then return and install.",
                url: new URL("/#install", Astro.site).href,
              },
              {
                "@type": "HowToStep",
                name: "Answer the Play Protect prompt",
                text: "Play Protect flags any app it has never seen outside the Play Store. Choose “install anyway”, or turn off “Scan apps that have been installed from outside of the Play Store” in Play Store → Play Protect → Settings.",
                url: new URL("/#install", Astro.site).href,
              },
              {
                "@type": "HowToStep",
                name: "Open the app and sign in",
                text: "Launch BreakFree and sign in with Google to begin.",
                url: new URL("/#install", Astro.site).href,
              },
            ],
          },
        ],
      })}
    />
    <title>{title}</title>
    <script is:inline>
      // Apply saved theme + language before first paint (no flash).
      (function () {
        var d = document.documentElement;
        try {
          var t =
            localStorage.getItem("bf-theme") ||
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          d.dataset.theme = t;
          var l = localStorage.getItem("bf-lang") || "en";
          d.lang = l;
          d.dir = l === "ar" ? "rtl" : "ltr";
          if (t === "dark") {
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute("content", "#16120d");
          }
        } catch (e) {}
      })();
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <slot />

    <script>
      // Scroll: progress bar + the hero sun rises as you leave the top.
      const bar = document.getElementById("progress");
      const sun = document.querySelector<HTMLElement>(".hero__sun");
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const max =
            document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          if (bar) bar.style.transform = `scaleX(${p})`;
          if (sun) sun.style.setProperty("--rise", `${(-p * 90).toFixed(1)}px`);
          ticking = false;
        });
      };
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Scroll-triggered reveals — one tiny observer, no framework.
      const targets = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-in"));
      }

      export {};
    </script>
  </body>
</html>
