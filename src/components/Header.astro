---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const apkLocal = fileURLToPath(new URL("../../public/BreakFree.apk", import.meta.url));
// Serve the APK same-origin when the build fetched it (mobile browsers
// handle that far better than GitHub's redirect chain); otherwise fall
// back to the GitHub release page.
const apkHref = existsSync(apkLocal)
  ? "/BreakFree.apk"
  : "https://github.com/YUouriii/taafi-app/releases/latest";

const links = [
  {
    href: "#ledger",
    en: "The tools",
    ar: "الأدوات",
  },
  {
    href: "#night",
    en: "The shields",
    ar: "الدروع",
  },
  {
    href: "#promise",
    en: "The promise",
    ar: "العهد",
  },
  {
    href: "#install",
    en: "Install",
    ar: "التثبيت",
  },
];
---

<header class="site-head">
  <div class="container site-head__row">
    <a class="brand" href="#top">
      <span class="brand__en">BreakFree</span>
      <span class="brand__ar ar" lang="ar">تعافي</span>
    </a>
    <nav class="site-head__nav mono" aria-label="Site">
      {
        links.map((l) => (
          <a href={l.href}>
            <span class="t-en">{l.en}</span>
            <span class="t-ar" lang="ar" dir="rtl">
              {l.ar}
            </span>
          </a>
        ))
      }
      <a
        href="https://github.com/YUouriii/taafi-app"
        class="site-head__gh"
        target="_blank"
        rel="noopener noreferrer">
        <span class="t-en">Source ↗</span>
        <span class="t-ar" lang="ar" dir="rtl">المصدر ↗</span>
      </a>

      <a
        href={apkHref}
        class="site-head__dl"
        download="BreakFree.apk"
        data-apk-dl
      >
        <span class="t-en">Download APK</span>
        <span class="t-ar" lang="ar" dir="rtl">تنزيل الـ <span class="lat" lang="en" dir="ltr">APK</span></span>
      </a>

      <div class="site-head__toggles">
        <button
          id="lang-toggle"
          class="tgl tgl--lang"
          type="button"
          aria-label="Switch language / تغيير اللغة"
          title="Language (L)"
        >
          <span class="tgl__en mono">عربي</span>
          <span class="tgl__ar ar">EN</span>
        </button>
        <button
          id="theme-toggle"
          class="tgl tgl--theme"
          type="button"
          aria-label="Switch theme"
          title="Theme (T)"
          aria-pressed="false"
        >
          <svg class="tgl__moon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M16.5 12.2A7 7 0 0 1 7.8 3.5 7 7 0 1 0 16.5 12.2Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
          <svg class="tgl__sun" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.5" />
            <path
              d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M16 4l-1.4 1.4M5.4 14.6L4 16M16 16l-1.4-1.4M5.4 5.4L4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    transition: background-color 0.5s var(--ease-out);
  }

  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand__en {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 0, "WONK" 1;
    font-weight: 560;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .brand__ar {
    color: var(--dawn);
    font-size: 1.1rem;
    line-height: 1;
  }

  .site-head__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
  }

  .site-head__nav a {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s var(--ease-out);
  }

  .site-head__nav a:hover {
    color: var(--ink);
  }

  .site-head__gh {
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    color: var(--ink) !important;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .site-head__gh:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper) !important;
  }

  .site-head__dl {
    background: var(--dawn);
    border: 1px solid var(--dawn);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    color: #fdf7ec !important;
    transition:
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .site-head__dl:hover {
    background: var(--dawn-deep);
    border-color: var(--dawn-deep);
    transform: translateY(-1px);
  }

  .site-head__toggles {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tgl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding: 0 0.65rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .tgl:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* which label the language pill shows (the language you'd switch to) */
  .tgl__ar {
    display: none;
    font-size: 0.85rem;
    line-height: 1;
  }

  html[lang="ar"] .tgl__en {
    display: none;
  }

  html[lang="ar"] .tgl__ar {
    display: inline;
  }

  .tgl--theme {
    padding: 0;
    width: 2.1rem;
  }

  .tgl svg {
    width: 15px;
    height: 15px;
  }

  /* show the icon of the theme you'd switch to */
  .tgl__sun {
    display: none;
  }

  html[data-theme="dark"] .tgl__sun {
    display: block;
  }

  html[data-theme="dark"] .tgl__moon {
    display: none;
  }

  @media (max-width: 720px) {
    /* on small screens keep only the download pill + toggles */
    .site-head__nav a:not(.site-head__dl) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    /* compact header so nothing overflows a 320–400px phone */
    .brand__ar {
      display: none;
    }

    .site-head__row {
      gap: 0.75rem;
    }

    .site-head__toggles {
      gap: 0.35rem;
    }

    .site-head__dl {
      font-size: 0.62rem;
      padding: 0.45em 0.75em;
    }

    .tgl {
      min-width: 1.9rem;
      height: 1.9rem;
    }

    .tgl svg {
      width: 13px;
      height: 13px;
    }
  }
</style>

<script>
  const html = document.documentElement;
  const langBtn = document.getElementById("lang-toggle") as HTMLButtonElement | null;
  const themeBtn = document.getElementById("theme-toggle") as HTMLButtonElement | null;

  const TITLES = {
    en: "BreakFree / تعافي — a private recovery companion for Android",
    ar: "بريك فري / تعافي — رفيق تعافٍ خاص على Android",
  };

  const applyLang = (l: string) => {
    html.lang = l;
    html.dir = l === "ar" ? "rtl" : "ltr";
    document.title = TITLES[l as "en" | "ar"];
    try {
      localStorage.setItem("bf-lang", l);
    } catch {}
  };

  langBtn?.addEventListener("click", () => {
    applyLang(html.lang === "ar" ? "en" : "ar");
  });

  const applyTheme = (t: string) => {
    html.dataset.theme = t;
    themeBtn?.setAttribute("aria-pressed", String(t === "dark"));
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", t === "dark" ? "#16120d" : "#f6f1e7");
    try {
      localStorage.setItem("bf-theme", t);
    } catch {}
  };

  themeBtn?.addEventListener("click", () => {
    applyTheme(html.dataset.theme === "dark" ? "light" : "dark");
  });

  // Keyboard shortcuts: T = theme, L = language.
  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const el = document.activeElement;
    if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA")) return;
    if (e.key === "t" || e.key === "T") themeBtn?.click();
    if (e.key === "l" || e.key === "L") langBtn?.click();
  });
</script>
