---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import release from "../data/release.json";

const apkLocal = fileURLToPath(new URL("../../public/BreakFree.apk", import.meta.url));
const apkHref = existsSync(apkLocal)
  ? "/BreakFree.apk"
  : "https://github.com/YUouriii/taafi-app/releases/latest";
const tag = release.tag.replace(/^v/, "");

const CERT_SHA256 =
  "cfbe0eb1227d7af977f8dae122d1deb1fd18e0e30108a4bcad05472a786d0ba7";
const CERT_SHA1 = "82b87684f0fb70a34074e18e9873e874db26b332";

const why = [
  {
    en: "Android blocks apps that don't come from the Play Store",
    ar: "أندرويد يحجب التطبيقات التي لا تأتي من متجر Play",
    text: {
      en: "Google's installer only trusts one channel. An APK is an app package outside that channel, so the phone asks you — every single time — to approve the source. The prompt is about provenance, not malware.",
      ar: "مثبّت Google يثق بقناة واحدة فقط. ملف APK حزمة تطبيق خارج تلك القناة، فيطلب الهاتف موافقتك — في كل مرة — على المصدر. التحذير عن المصدر، لا عن البرمجيات الخبيثة.",
    },
  },
  {
    en: "Play Protect has never seen this app before",
    ar: "Play Protect لم يرَ هذا التطبيق من قبل",
    text: {
      en: "Play Protect scans apps outside the Play Store and asks Google about them. Because BreakFree is new, has no store listing, and has no reputation history yet, it answers \"unrecognized app\" — a verdict about novelty, not about safety.",
      ar: "Play Protect يفحص التطبيقات خارج متجر Play ويسأل Google عنها. ولأن BreakFree جديد، ولا صفحة له في المتجر، ولا سجل سمعة بعد، فيردّ: «تطبيق غير معروف» — حكم على الحداثة، لا على الأمان.",
    },
  },
  {
    en: "The warning is a generic notice, not a diagnosis",
    ar: "التحذير إشعار عام، ليس تشخيصًا",
    text: {
      en: "Google sends the same wording for every sideloaded app — including hobby projects and your own builds. It cannot name a threat, because there isn't one to name.",
      ar: "يرسل Google الصياغة نفسها لكل تطبيق مثبَّت يدويًا — بما في ذلك المشاريع الشخصية وبناءاتك أنت. لا يستطيع أن يسمّي تهديدًا، لأنه لا يوجد تهديد ليُسمّى.",
    },
  },
];

const steps = [
  {
    en: "Download the file",
    ar: "نزّل الملف",
    text: {
      en: "Tap the download button. The APK lands in your Downloads folder.",
      ar: "اضغط زر التنزيل. يستقر ملف APK في مجلد التنزيلات.",
    },
  },
  {
    en: "Open it from Files",
    ar: "افتحه من الملفات",
    text: {
      en: "Open Files → Downloads → BreakFree.apk. Tap Install.",
      ar: "افتح «الملفات» ← التنزيلات ← BreakFree.apk. اضغط «تثبيت».",
    },
  },
  {
    en: "Allow this source, once",
    ar: "اسمح بهذا المصدر، مرة واحدة",
    text: {
      en: "If Android says \"for your security, this file is blocked\", tap Settings → Allow from this source → flip the switch for the app you're using (Files or Chrome) → back → Install. Android 8 and later ask per-app on purpose.",
      ar: "إذا قال أندرويد «لأمانك، تم حظر هذا الملف»، اضغط إعدادات ← السماح من هذا المصدر ← فعّل المفتاح للتطبيق الذي تستخدمه (الملفات أو Chrome) ← رجع ← تثبيت. منذ أندرويد 8 يُطلب الإذن لكل تطبيق عن قصد.",
    },
  },
  {
    en: "Answer Play Protect",
    ar: "ردّ على Play Protect",
    text: {
      en: "It will ask whether you want to scan the app. Choose \"install anyway\" / \"more details → install anyway\". Or silence it once and for all: Play Store → avatar → Play Protect → Settings → turn off \"Scan apps that have been installed from outside of the Play Store\".",
      ar: "سيسألك إن كنت تريد فحص التطبيق. اختر «التثبيت على أي حال» أو «المزيد من التفاصيل ← التثبيت على أي حال». أو أوقفه نهائيًا: متجر Play ← صورتك ← Play Protect ← الإعدادات ← أطفِ «فحص التطبيقات المثبَّتة من خارج متجر Play».",
    },
  },
  {
    en: "Open it and sign in",
    ar: "افتحه وسجّل الدخول",
    text: {
      en: "Launch BreakFree, sign in with Google, and your streak starts at zero. Nothing is seeded, nothing is uploaded until you do.",
      ar: "شغّل BreakFree، وسجّل الدخول بحساب Google، فيبدأ عدّادك من الصفر. لا شيء مُزرع، ولا شيء يُرفع حتى تفعل ذلك بنفسك.",
    },
  },
];

const trust = [
  {
    label: { en: "Signing certificate SHA-256", ar: "بصمة شهادة التوقيع SHA-256" },
    value: CERT_SHA256,
  },
  {
    label: { en: "Signing certificate SHA-1", ar: "بصمة شهادة التوقيع SHA-1" },
    value: CERT_SHA1,
  },
];
---

<section class="section install" id="install">
  <div class="container">
    <p class="section-label" data-reveal>
      <span class="t-en">Before you download</span>
      <span class="t-ar" lang="ar" dir="rtl">قبل أن تنزّل</span>
    </p>
    <h2 class="install__title" data-reveal style="--d:.06s">
      <span class="t-en">Your phone is going<br /><em>to warn you.</em></span>
      <span class="t-ar" lang="ar" dir="rtl">
        سيحذّرك هاتفك.<br /><em>وهذا متوقّع.</em>
      </span>
    </h2>

    <aside class="install__notice" data-reveal style="--d:.1s">
      <p class="install__notice-tag mono">
        <span class="t-en">Heads-up</span>
        <span class="t-ar" lang="ar" dir="rtl">تنبيه</span>
      </p>
      <p class="install__notice-body">
        <span class="t-en">
          The moment you install BreakFree, Android will warn you about an
          unknown source, and Play Protect will say it hasn't seen this app
          before. That is what happens with every app outside the Play Store.
          It is a formality, not a finding. Read this once, then download
          with your eyes open.
        </span>
        <span class="t-ar" lang="ar" dir="rtl">
          في اللحظة التي تثبّت فيها BreakFree، سيحذّرك أندرويد من مصدر غير
          معروف، ويقول Play Protect إنه لم يرَ هذا التطبيق من قبل. هذا ما
          يحدث مع كل تطبيق خارج متجر Play. إجراء شكلي، لا حكم. اقرأ هذا مرة
          واحدة، ثم نزّل وأنت تعرف ما الذي سيحدث.
        </span>
      </p>
    </aside>

    <p class="install__lede" data-reveal style="--d:.12s">
      <span class="t-en">
        Here is exactly what the warning says, why it says it, what to tap,
        and how to verify the file is ours.
      </span>
      <span class="t-ar" lang="ar" dir="rtl">
        إليك ما تقوله التحذير حرفيًا، ولماذا يقوله، وما الذي تضغطه، وكيف
        تتحقّق أن الملف ملفنا.
      </span>
    </p>

    <div class="install__grid">
      <div class="install__why">
        <p class="install__col-label mono" data-reveal style="--d:.12s">
          <span class="t-en">What the warning means</span>
          <span class="t-ar" lang="ar" dir="rtl">ماذا يعني التحذير</span>
        </p>
        {
          why.map((w, i) => (
            <article class="install__card" data-reveal style={`--d:${0.12 + i * 0.05}s`}>
              <h3>
                <span class="t-en">{w.en}</span>
                <span class="t-ar" lang="ar" dir="rtl">
                  {w.ar}
                </span>
              </h3>
              <p>
                <span class="t-en">{w.text.en}</span>
                <span class="t-ar" lang="ar" dir="rtl">
                  {w.text.ar}
                </span>
              </p>
            </article>
          ))
        }
      </div>

      <div class="install__steps" data-reveal style="--d:.15s">
        <p class="install__steps-label mono">
          <span class="t-en">Five steps, once</span>
          <span class="t-ar" lang="ar" dir="rtl">خمس خطوات، مرة واحدة</span>
        </p>
        <ol>
          {
            steps.map((s, i) => (
              <li>
                <span class="install__num mono">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h4>
                    <span class="t-en">{s.en}</span>
                    <span class="t-ar" lang="ar" dir="rtl">
                      {s.ar}
                    </span>
                  </h4>
                  <p>
                    <span class="t-en">{s.text.en}</span>
                    <span class="t-ar" lang="ar" dir="rtl">
                      {s.text.ar}
                    </span>
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="install__trust">
          <p class="install__trust-title">
            <span class="t-en">Want proof it's ours? Compare the fingerprint.</span>
            <span class="t-ar" lang="ar" dir="rtl">
              تريد دليلًا أنه ملفنا؟ قارن البصمة.
            </span>
          </p>
          {
            trust.map((t) => (
              <p class="install__hash mono">
                <span class="install__hash-label">
                  <span class="t-en">{t.label.en}</span>
                  <span class="t-ar" lang="ar" dir="rtl">
                    {t.label.ar}
                  </span>
                </span>
                <span class="install__hash-value">{t.value}</span>
              </p>
            ))
          }
          <p class="install__trust-note">
            <span class="t-en">
              Any tool that reads an APK's signature (APK Signature Scheme v2/v3
              — <code>apksigner verify --print-certs</code>, or an APK hash
              checker app) prints this same fingerprint for our build. The
              source is public, line by line, on GitHub.
            </span>
            <span class="t-ar" lang="ar" dir="rtl">
              أي أداة تقرأ توقيع الـ APK (نظام توقيع أندرويد v2/v3 — أو تطبيق
              فاحص بصمات) تطبع البصمة نفسها لبنائنا. والمصدر علني، سطرًا سطرًا،
              على GitHub.
            </span>
          </p>
          <div class="install__get">
            <a
              class="btn btn--solid"
              href={apkHref}
              download="BreakFree.apk"
              data-apk-dl>
              <span class="t-en">Download the APK — v{tag}</span>
              <span class="t-ar" lang="ar" dir="rtl">حمّل الـ APK — v{tag}</span>
            </a>
            <span class="install__get-note">
              <span class="t-en">
                A warning will appear on install. Now you know why.
              </span>
              <span class="t-ar" lang="ar" dir="rtl">
                سيظهر تحذير عند التثبيت. والآن تعرف لماذا.
              </span>
            </span>
          </div>

          <p class="install__links mono">
            <a
              href="https://github.com/YUouriii/taafi-app"
              target="_blank"
              rel="noopener noreferrer">
              <span class="t-en">Read the source ↗</span>
              <span class="t-ar" lang="ar" dir="rtl">اقرأ المصدر ↗</span>
            </a>
            <span aria-hidden="true">·</span>
            <a
              href="https://github.com/YUouriii/taafi-app/releases"
              target="_blank"
              rel="noopener noreferrer">
              <span class="t-en">All releases ↗</span>
              <span class="t-ar" lang="ar" dir="rtl">كل الإصدارات ↗</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .install__title {
    margin-top: 1.6rem;
  }

  .install__notice {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.3rem, 2.5vw, 1.9rem);
    border: 1px solid var(--hairline-strong);
    border-inline-start: 3px solid var(--dawn);
    background: color-mix(in srgb, var(--dawn) 7%, transparent);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.4rem;
    align-items: baseline;
  }

  .install__notice-tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dawn);
    white-space: nowrap;
  }

  .install__notice-body {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 68ch;
  }

  html[lang="ar"] .install__notice-body {
    font-family: var(--font-arabic);
    line-height: 1.9;
  }

  .install__col-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.9rem;
  }

  .install__lede {
    margin-top: 1.8rem;
    max-width: 62ch;
    font-size: var(--fs-body);
    color: var(--ink-soft);
  }

  html[lang="ar"] .install__lede {
    font-size: clamp(1.15rem, 1.1rem + 0.3vw, 1.3rem);
    line-height: 1.95;
    font-family: var(--font-arabic);
  }

  html[lang="ar"] .install__trust-note {
    font-size: 1rem;
    line-height: 1.9;
  }

  html[lang="ar"] .install__get-note {
    font-size: 1.05rem;
  }

  .install__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .install__card {
    border-top: 1px solid var(--hairline);
    padding-block: 1.5rem;
  }

  .install__card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .install__card p {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }

  .install__steps {
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper-deep) 45%, transparent);
    padding: clamp(1.5rem, 3vw, 2.4rem);
  }

  .install__steps-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dawn);
  }

  .install__steps ol {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
  }

  .install__steps li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0 0.9rem;
    padding-block: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .install__num {
    font-size: 0.78rem;
    color: var(--dawn);
    padding-top: 0.2rem;
  }

  .install__steps h4 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .install__steps p {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .install__trust {
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline-strong);
  }

  .install__trust-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .install__hash {
    margin-top: 0.9rem;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .install__hash-label {
    display: block;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .install__hash-value {
    display: block;
    margin-top: 0.25rem;
    word-break: break-all;
    color: var(--dawn);
  }

  .install__trust-note {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .install__trust-note code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--ink);
  }

  .install__get {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.2rem;
  }

  .install__get-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  html[lang="ar"] .install__get-note {
    font-style: normal;
    font-family: var(--font-arabic);
  }

  .install__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .install__links a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s var(--ease-out);
  }

  .install__links a:hover {
    color: var(--dawn-deep);
  }

  @media (max-width: 900px) {
    .install__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
