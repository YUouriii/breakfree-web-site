---
import release from "../data/release.json";

const CERT_SHA256 =
  "cfbe0eb1227d7af977f8dae122d1deb1fd18e0e30108a4bcad05472a786d0ba7";
const CERT_SHA1 = "82b87684f0fb70a34074e18e9873e874db26b332";

const why = [
  {
    en: "Android blocks apps that don't come from the Play Store",
    ar: "أندرويد يحجب التطبيقات التي لا تأتي من متجر Play",
    text: {
      en: "Google's installer only trusts one channel. An APK is an app package outside that channel, so the phone asks you — every single time — to approve the source. The prompt is about provenance, not malware.",
      ar: "مثبّت Google يثق بقناة واحدة فقط. ملف APK حزمة تطبيق خارج تلك القناة، فيطلب الهاتف موافقتك — في كل مرة — على المصدر. التحذير عن المصدر، لا عن البرمجيات الخبيثة.",
    },
  },
  {
    en: "Play Protect has never seen this app before",
    ar: "Play Protect لم يرَ هذا التطبيق من قبل",
    text: {
      en: "Play Protect scans apps outside the Play Store and asks Google about them. Because BreakFree is new, has no store listing, and has no reputation history yet, it answers \"unrecognized app\" — a verdict about novelty, not about safety.",
      ar: "Play Protect يفحص التطبيقات خارج متجر Play ويسأل Google عنها. ولأن BreakFree جديد، ولا صفحة له في المتجر، ولا سجل سمعة بعد، فيردّ: «تطبيق غير معروف» — حكم على الحداثة، لا على الأمان.",
    },
  },
  {
    en: "The warning is a generic notice, not a diagnosis",
    ar: "التحذير إشعار عام، ليس تشخيصًا",
    text: {
      en: "Google sends the same wording for every sideloaded app — including hobby projects and your own builds. It cannot name a threat, because there isn't one to name.",
      ar: "يرسل Google الصياغة نفسها لكل تطبيق مثبَّت يدويًا — بما في ذلك المشاريع الشخصية وبناءاتك أنت. لا يستطيع أن يسمّي تهديدًا، لأنه لا يوجد تهديد ليُسمّى.",
    },
  },
];

const steps = [
  {
    en: "Download the file",
    ar: "نزّل الملف",
    text: {
      en: "Tap the download button. The APK lands in your Downloads folder.",
      ar: "اضغط زر التنزيل. يستقر ملف APK في مجلد التنزيلات.",
    },
  },
  {
    en: "Open it from Files",
    ar: "افتحه من الملفات",
    text: {
      en: "Open Files → Downloads → BreakFree.apk. Tap Install.",
      ar: "افتح «الملفات» ← التنزيلات ← BreakFree.apk. اضغط «تثبيت».",
    },
  },
  {
    en: "Allow this source, once",
    ar: "اسمح بهذا المصدر، مرة واحدة",
    text: {
      en: "If Android says \"for your security, this file is blocked\", tap Settings → Allow from this source → flip the switch for the app you're using (Files or Chrome) → back → Install. Android 8 and later ask per-app on purpose.",
      ar: "إذا قال أندرويد «لأمانك، تم حظر هذا الملف»، اضغط إعدادات ← السماح من هذا المصدر ← فعّل المفتاح للتطبيق الذي تستخدمه (الملفات أو Chrome) ← رجع ← تثبيت. منذ أندرويد 8 يُطلب الإذن لكل تطبيق عن قصد.",
    },
  },
  {
    en: "Answer Play Protect",
    ar: "ردّ على Play Protect",
    text: {
      en: "It will ask whether you want to scan the app. Choose \"install anyway\" / \"more details → install anyway\". Or silence it once and for all: Play Store → avatar → Play Protect → Settings → turn off \"Scan apps that have been installed from outside of the Play Store\".",
      ar: "سيسألك إن كنت تريد فحص التطبيق. اختر «التثبيت على أي حال» أو «المزيد من التفاصيل ← التثبيت على أي حال». أو أوقفه نهائيًا: متجر Play ← صورتك ← Play Protect ← الإعدادات ← أطفِ «فحص التطبيقات المثبَّتة من خارج متجر Play».",
    },
  },
  {
    en: "Open it and sign in",
    ar: "افتحه وسجّل الدخول",
    text: {
      en: "Launch BreakFree, sign in with Google, and your streak starts at zero. Nothing is seeded, nothing is uploaded until you do.",
      ar: "شغّل BreakFree، وسجّل الدخول بحساب Google، فيبدأ عدّادك من الصفر. لا شيء مُزرع، ولا شيء يُرفع حتى تفعل ذلك بنفسك.",
    },
  },
];

const trust = [
  {
    label: { en: "Signing certificate SHA-256", ar: "بصمة شهادة التوقيع SHA-256" },
    value: CERT_SHA256,
  },
  {
    label: { en: "Signing certificate SHA-1", ar: "بصمة شهادة التوقيع SHA-1" },
    value: CERT_SHA1,
  },
];
---

<section class="section install" id="install">
  <div class="container">
    <p class="section-label" data-reveal>
      <span class="t-en">Installing</span>
      <span class="t-ar" lang="ar" dir="rtl">التثبيت</span>
    </p>
    <h2 class="install__title" data-reveal style="--d:.06s">
      <span class="t-en">Why your phone<br /><em>will warn you.</em></span>
      <span class="t-ar" lang="ar" dir="rtl">
        لماذا سيحذّرك<br /><em>هاتفك؟</em>
      </span>
    </h2>
    <p class="install__lede" data-reveal style="--d:.1s">
      <span class="t-en">
        Almost everyone who installs BreakFree sees a scary screen first. Here
        is exactly what it says, why it says it, and how to get past it in
        five steps.
      </span>
      <span class="t-ar" lang="ar" dir="rtl">
        كلّ من يثبّت BreakFree يرى شاشة مخيفة أولًا. إليك ما تقوله حرفيًا،
        ولماذا تقولها، وكيف تتجاوزها في خمس خطوات.
      </span>
    </p>

    <div class="install__grid">
      <div class="install__why">
        {
          why.map((w, i) => (
            <article class="install__card" data-reveal style={`--d:${0.12 + i * 0.05}s`}>
              <h3>
                <span class="t-en">{w.en}</span>
                <span class="t-ar" lang="ar" dir="rtl">
                  {w.ar}
                </span>
              </h3>
              <p>
                <span class="t-en">{w.text.en}</span>
                <span class="t-ar" lang="ar" dir="rtl">
                  {w.text.ar}
                </span>
              </p>
            </article>
          ))
        }
      </div>

      <div class="install__steps" data-reveal style="--d:.15s">
        <p class="install__steps-label mono">
          <span class="t-en">Five steps, once</span>
          <span class="t-ar" lang="ar" dir="rtl">خمس خطوات، مرة واحدة</span>
        </p>
        <ol>
          {
            steps.map((s, i) => (
              <li>
                <span class="install__num mono">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h4>
                    <span class="t-en">{s.en}</span>
                    <span class="t-ar" lang="ar" dir="rtl">
                      {s.ar}
                    </span>
                  </h4>
                  <p>
                    <span class="t-en">{s.text.en}</span>
                    <span class="t-ar" lang="ar" dir="rtl">
                      {s.text.ar}
                    </span>
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="install__trust">
          <p class="install__trust-title">
            <span class="t-en">Want proof it's ours? Compare the fingerprint.</span>
            <span class="t-ar" lang="ar" dir="rtl">
              تريد دليلًا أنه ملفنا؟ قارن البصمة.
            </span>
          </p>
          {
            trust.map((t) => (
              <p class="install__hash mono">
                <span class="install__hash-label">
                  <span class="t-en">{t.label.en}</span>
                  <span class="t-ar" lang="ar" dir="rtl">
                    {t.label.ar}
                  </span>
                </span>
                <span class="install__hash-value">{t.value}</span>
              </p>
            ))
          }
          <p class="install__trust-note">
            <span class="t-en">
              Any tool that reads an APK's signature (APK Signature Scheme v2/v3
              — <code>apksigner verify --print-certs</code>, or an APK hash
              checker app) prints this same fingerprint for our build. The
              source is public, line by line, on GitHub.
            </span>
            <span class="t-ar" lang="ar" dir="rtl">
              أي أداة تقرأ توقيع الـ APK (نظام توقيع أندرويد v2/v3 — أو تطبيق
              فاحص بصمات) تطبع البصمة نفسها لبنائنا. والمصدر علني، سطرًا سطرًا،
              على GitHub.
            </span>
          </p>
          <p class="install__links mono">
            <a
              href="https://github.com/YUouriii/taafi-app"
              target="_blank"
              rel="noopener noreferrer">
              <span class="t-en">Read the source ↗</span>
              <span class="t-ar" lang="ar" dir="rtl">اقرأ المصدر ↗</span>
            </a>
            <span aria-hidden="true">·</span>
            <a href="/BreakFree.apk" download="BreakFree.apk">
              <span class="t-en">Download v{release.tag.replace(/^v/, "")}</span>
              <span class="t-ar" lang="ar" dir="rtl">
                نزّل v{release.tag.replace(/^v/, "")}
              </span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .install__title {
    margin-top: 1.6rem;
  }

  .install__lede {
    margin-top: 1.8rem;
    max-width: 62ch;
    font-size: var(--fs-body);
    color: var(--ink-soft);
  }

  .install__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .install__card {
    border-top: 1px solid var(--hairline);
    padding-block: 1.5rem;
  }

  .install__card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .install__card p {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }

  .install__steps {
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper-deep) 45%, transparent);
    padding: clamp(1.5rem, 3vw, 2.4rem);
  }

  .install__steps-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dawn);
  }

  .install__steps ol {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
  }

  .install__steps li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0 0.9rem;
    padding-block: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .install__num {
    font-size: 0.78rem;
    color: var(--dawn);
    padding-top: 0.2rem;
  }

  .install__steps h4 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .install__steps p {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .install__trust {
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline-strong);
  }

  .install__trust-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .install__hash {
    margin-top: 0.9rem;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .install__hash-label {
    display: block;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .install__hash-value {
    display: block;
    margin-top: 0.25rem;
    word-break: break-all;
    color: var(--dawn);
  }

  .install__trust-note {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .install__trust-note code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--ink);
  }

  .install__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .install__links a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s var(--ease-out);
  }

  .install__links a:hover {
    color: var(--dawn-deep);
  }

  @media (max-width: 900px) {
    .install__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
