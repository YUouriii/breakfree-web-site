  description="BreakFree (تعافي) is an open-source Android recovery companion for quitting compulsive pornography use: a live clean-streak tracker, CBT-based SOS exercises, an AI counselor, and an anonymous community. Private by design. Bilingual English / العربية."
>
  <Header />
  <main>
    <Hero />
    <Marquee />
    <Ledger />
    <Night />
    <Commitment />
    <Bilingual />
    <Promises />
    <InstallGuide />
    <CallToAction />
  </main>
  <Footer />
</Layout>
